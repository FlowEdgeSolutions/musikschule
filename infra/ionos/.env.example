# Kopiervorlage: auf dem Server nach infra/ionos/.env kopieren und ausfüllen.
# Diese Datei enthält KEINE echten Werte und gehört ins Repo — .env nicht.

# Adressen, für die Caddy ein Zertifikat holt — kommagetrennt.
# Jede muss per DNS auf den Server zeigen, sonst schlägt die Ausstellung fehl.
# Beispiel mit www: schnittke-akademie.de, www.schnittke-akademie.de
SITE_ADDRESSES=musikschule.flowedge.com

POSTGRES_DB=schnittke
POSTGRES_USER=schnittke
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Auf dem Entwicklungsrechner erzeugen:
#   cd frontend && npm run admin:hash -- "mein-passwort"
# Der Wert hat die Form scrypt:16384:8:1:<salt>:<hash> und enthält bewusst
# keine "$" — die würde Docker Compose als Variable interpretieren.
ADMIN_PASSWORD_HASH=

# openssl rand -base64 32
ADMIN_SESSION_SECRET=
