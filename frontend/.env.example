# Kopiervorlage für die lokale Entwicklung: nach .env kopieren und ausfüllen.
# Auf dem Server werden diese Werte über infra/ionos/.env gesetzt.

DATABASE_URL=postgresql://schnittke:schnittke@localhost:5432/schnittke

# Erzeugen mit: npm run admin:hash -- "mein-passwort"
ADMIN_PASSWORD_HASH=

# Lange Zufallszeichenkette, z.B. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=
